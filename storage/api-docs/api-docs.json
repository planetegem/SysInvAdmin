                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Language details with items tree",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LanguageResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid identifier type provided"
                    },
                    "404": {
                        "description": "Language not found"
                    }
                }
            }
        },
        "/api/media/index": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "A simple media index. Tells you the tpe of a medium and whether its attached to anything.",
                "operationId": "4d52b3e2ad4241d661c949c3a211f28c",
                "responses": {
                    "200": {
                        "description": "List of media references",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/MediumIndex"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/media/all": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "Fetch media",
                "operationId": "d7d941a00527b4b5d5e78b906c26b493",
                "parameters": [
                    {
                        "name": "types[]",
                        "in": "query",
                        "description": "Filter items by type. Accepts multiple types (OR).",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "description": "Define order which media are returned (descending or ascending, by creation date)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "descending"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "count": {
                                            "type": "integer",
                                            "example": 42
                                        },
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 3
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "result": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/MediumResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/media/id/{id}": {
            "get": {
                "tags": [
                    "Media"
                ],
                "summary": "Fetch specific medium, based on its internal id",
                "operationId": "9f5ea1f005d460ea6fb4d8b6461c1c4c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The medium ID integer",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "11"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MediumResource"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Media item not found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "CategoryIndex": {
                "title": "Category Index",
                "description": "Bare minimum category representation for URL building",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 11
                    },
                    "name": {
                        "type": "string",
                        "example": "Het Vleeskanon"
                    },
                    "slug": {
                        "type": "string",
                        "example": "het-vleeskanon"
                    },
                    "hidden": {
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "CategoryResource": {
                "title": "Category Resource",
                "description": "A category used to label or tag items",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 11
                    },
                    "name": {
                        "type": "string",
                        "example": "Het Vleeskanon"
                    },
                    "slug": {
                        "type": "string",
                        "example": "het-vleeskanon"
                    },
                    "title": {
                        "type": "string",
                        "example": "The Meatcannon (all chapters)",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "example": "A short (or absent) description of the category, for public use",
                        "nullable": true
                    },
                    "meta_title": {
                        "type": "string",
                        "example": "SEO title of the category",
                        "nullable": true
                    },
                    "meta_description": {
                        "type": "string",
                        "example": "SEO description of the category",
                        "nullable": true
                    },
                    "hidden": {
                        "type": "boolean",
                        "example": true
                    },
                    "items": {
                        "oneOf": [
                            {
                                "description": "Array of simplified Item objects (purely to construct links)",
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ItemIndex"
                                }
                            },
                            {
                                "description": "Array of detailed Item objects (when fetching a single category)",
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ItemResource"
                                }
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "ImageResource": {
                "title": "Image Resource",
                "description": "Images saved on the server: their paths and meta data.",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "naked_man"
                    },
                    "path": {
                        "type": "string",
                        "example": "https://example.com/storage/images/image_of_naked_man.webp"
                    },
                    "alt": {
                        "type": "string",
                        "example": "An image of a naked man",
                        "nullable": true
                    },
                    "properties": {
                        "properties": {
                            "mime": {
                                "type": "string",
                                "example": "image/webp"
                            },
                            "size": {
                                "type": "integer",
                                "example": 10234
                            },
                            "width": {
                                "type": "integer",
                                "example": 550
                            },
                            "height": {
                                "type": "integer",
                                "example": 1000
                            },
                            "aspect_ratio": {
                                "type": "number",
                                "example": 0.55
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ItemIndex": {
                "title": "Item Index",
                "description": "Return the item id, slug and name, exactly enough to create a link to an individual item.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Mangerie Online, version 2"
                    },
                    "slug": {
                        "type": "string",
                        "example": "mangerie-online-version-2"
                    }
                },
                "type": "object"
            },
            "ItemRelationship": {
                "title": "Item Relationship Resource",
                "properties": {
                    "relationship": {
                        "properties": {
                            "label": {
                                "type": "string",
                                "example": "parent_of"
                            },
                            "descriptor": {
                                "type": "string",
                                "example": "is a parent of"
                            }
                        },
                        "type": "object"
                    },
                    "item": {
                        "type": "integer",
                        "example": 22
                    }
                },
                "type": "object"
            },
            "ItemResource": {
                "title": "Item Resource",
                "description": "Represents an individual item along with its conditionally loaded relationships and media.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-14T15:00:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-14T15:00:00.000000Z"
                    },
                    "title": {
                        "type": "string",
                        "example": "Mangerie Online, version 2"
                    },
                    "slug": {
                        "type": "string",
                        "example": "mangerie-online-version-2"
                    },
                    "description": {
                        "description": "Rendered content block string, can contain HTML.",
                        "type": "string",
                        "example": "<p>This is the item description.</p>",
                        "nullable": true
                    },
                    "language": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/LanguageResource"
                            }
                        ],
                        "nullable": true,
                        "description": "Present only when language relation is loaded."
                    },
                    "media": {
                        "description": "Present only when media relation is loaded.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MediumResource"
                        },
                        "nullable": true
                    },
                    "categories": {
                        "description": "Present only when categories relation is loaded.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryIndex"
                        },
                        "nullable": true
                    },
                    "links": {
                        "description": "Present only when links relation is loaded.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/LinkResource"
                        },
                        "nullable": true
                    },
                    "relationships": {
                        "description": "Omitted entirely if relations are not loaded or if no relationships exist.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ItemRelationship"
                        },
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "LanguageResource": {
                "title": "Language Resource",
                "description": "A Language that something is expressed in. Can have items attached to it. Querying a language reveals all items in that language.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "French"
                    },
                    "short_name": {
                        "type": "string",
                        "example": "fr"
                    },
                    "native_name": {
                        "type": "string",
                        "example": "français"
                    },
                    "items": {
                        "oneOf": [
                            {
                                "description": "Array of simplified Item objects (purely to construct links)",
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ItemIndex"
                                }
                            },
                            {
                                "description": "Array of detailed Item objects (when fetching a single category)",
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ItemResource"
                                }
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "LinkResource": {
                "title": "Link Resource",
                "description": "Links to be attached to items. Will become more extensive feature later on.",
                "properties": {
                    "anchor": {
                        "type": "string",
                        "example": "Visit the best site ever"
                    },
                    "url": {
                        "type": "string",
                        "example": "https://www.planetegem.be"
                    }
                },
                "type": "object"
            },
            "MediumIndex": {
                "title": "Medium Index",
                "description": "Index of all media, where a medium is a polymorphic container for media files.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "type": {
                        "type": "string",
                        "example": "image",
                        "enum": [
                            "image",
                            "image-list",
                            "carousel",
                            "video",
                            "gifv",
                            "3d-model"
                        ]
                    }
                },
                "type": "object"
            },
            "MediumResource": {
                "title": "Medium Resource",
                "description": "Polymorphic media container holding image or video files or 3D assets",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-14T15:00:00.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-14T15:00:00.000000Z"
                    },
                    "type": {
                        "type": "string",
                        "example": "image",
                        "enum": [
                            "none",
                            "image",
                            "image-list",
                            "carousel",
                            "video",
                            "gifv",
                            "3d-model"
                        ]
                    },
                    "files": {
                        "description": "Dynamic array that can contain files of the requested type (image, video or 3D asset)",
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "$ref": "#/components/schemas/ImageResource"
                                },
                                {
                                    "$ref": "#/components/schemas/VideoResource"
                                },
                                {
                                    "$ref": "#/components/schemas/Model3DResource"
                                }
                            ]
                        }
                    }
