{
    "openapi": "3.0.0",
    "info": {
        "title": "SysInvAdmin public API",
        "description": "This is the API documentation for the SysInvAdmin API.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current Environment"
        }
    ],
    "paths": {
        "/api/categories/index": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "A simple category index, useful for building URLs in the frontend.",
                "operationId": "37d2ced4e9ff9019b0f4ba622da2052d",
                "responses": {
                    "200": {
                        "description": "List of category references",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryIndex"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories/all": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Fetch all categories, including meta data and id's of related items",
                "operationId": "1191f6cb3151809beb26121a51c69f80",
                "parameters": [
                    {
                        "name": "includeHidden",
                        "in": "query",
                        "description": "Include hidden categories",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "example": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of category references",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/categories/{id_type}/{id}": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Fetch a specific category by ID or slug, including all related items",
                "operationId": "53cff77105dbe311468409c6a64f086f",
                "parameters": [
                    {
                        "name": "id_type",
                        "in": "path",
                        "description": "Type of identifier provided in the URL path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "id",
                            "enum": [
                                "id",
                                "slug"
                            ]
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The category ID integer or category slug string",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "11"
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "description": "Order of returned items related to the category",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "creation-descending",
                            "enum": [
                                "creation-ascending",
                                "creation-descending"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category details with items tree",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid identifier type provided"
                    },
                    "404": {
                        "description": "Category not found"
                    }
                }
            }
        },
        "/api/items/index": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "A simple item index, containing only the item id and slug. Useful to build URLs in the frontend.",
                "operationId": "fc6500f68a95477aedae3ea219a4eb94",
                "responses": {
                    "200": {
                        "description": "List of item references",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ItemIndex"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/items/all": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Fetch items",
                "operationId": "29f1465d33e954160c3999d07a42d9cb",
                "parameters": [
                    {
                        "name": "languages[]",
                        "in": "query",
                        "description": "Filter items by language (short name). Accepts multiple languages (OR).",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "language_ids[]",
                        "in": "query",
                        "description": "Filter items by language (id). Accepts multiple languages (OR).",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    },
                    {
                        "name": "categories[]",
                        "in": "query",
                        "description": "Filter items by category (identified with slug). Accepts multiple categories (OR).",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "category_ids[]",
                        "in": "query",
                        "description": "Filter items by category (identified with id). Accepts multiple categories (OR).",
                        "required": false,
                        "style": "form",
                        "explode": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "integer"
                            }
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "description": "Define order which items are returned (descending or ascending, by creation date)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "descending"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Number of items per page",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "count": {
                                            "type": "integer",
                                            "example": 42
                                        },
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 3
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "result": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ItemResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/items/id/{item_id}": {
            "get": {
                "tags": [
                    "Items"
                ],
                "summary": "Fetch specific item, based on its internal id",
                "operationId": "55999401c2a396a4f67dd079c80e84da",
                "parameters": [
                    {
                        "name": "id_type",
                        "in": "path",
                        "description": "Type of identifier provided in the URL path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "id",
                            "enum": [
                                "id",
                                "slug"
                            ]
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The item ID integer or item slug string",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "11"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Succes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ItemResource"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid identifier type provided"
                    },
                    "404": {
                        "description": "Item not found"
                    }
                }
            }
        },
        "/api/languages/all": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Fetch all languages, including id's of related items",
                "operationId": "ed86294b8004138952dc24bdf2a0d1d2",
                "responses": {
                    "200": {
                        "description": "List of language references",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/LanguageResource"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/languages/{id_type}/{id}": {
            "get": {
                "tags": [
                    "Languages"
                ],
                "summary": "Fetch a specific Language by ID or name, including all related items",
                "operationId": "3e914c5295f6bb752d5b8d71bc84167b",
                "parameters": [
                    {
                        "name": "id_type",
                        "in": "path",
                        "description": "Type of identifier provided in the URL path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "id",
                            "enum": [
                                "id",
                                "name"
                            ]
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The language ID integer or language slug string",
                        "required": true,
