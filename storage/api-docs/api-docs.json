                            "type": "string",
                            "example": "11"
                        }
                    },
                    {
                        "name": "order",
                        "in": "query",
                        "description": "Order of returned items related to the language",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "creation-descending",
                            "enum": [
                                "creation-ascending",
